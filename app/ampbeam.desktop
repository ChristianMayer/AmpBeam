#
# FreeDesktop entry so the installed application appears in the menu.
[Desktop Entry]
Type=Application
Name=AmpBeam
GenericName=AmpBeam
Comment=Read Bluetooth Low Energy multimeters that use the supported GATT profile
Exec=ampbeam
Icon=ampbeam
Terminal=false
Categories=Utility;Electronics;
Keywords=multimeter;bluetooth;ble;measurement;voltmeter;
